{
  "name": "scottsearch-for-obsidian",
  "version": "0.1.0",
  "description": "Fast, relevance-ranked search that feels native to Obsidian.",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run test && npm run build",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "search",
    "full-text-search"
  ],
  "author": "c4g-john",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.10.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "globals": "^16.4.0",
    "jiti": "^2.6.1",
    "obsidian": "latest",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^5.0.0"
  }
}
